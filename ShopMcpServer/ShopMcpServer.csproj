<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <!-- The same files SemanticSearchDemo uses: one copy of the business code, two hosts. -->
  <ItemGroup>
    <Compile Include="..\ProductSearch\Product.cs" Link="Shared\Product.cs" />
    <Compile Include="..\ProductSearch\Catalog.cs" Link="Shared\Catalog.cs" />
    <Compile Include="..\Tools\ShopTools.cs" Link="Shared\ShopTools.cs" />
  </ItemGroup>

</Project>
