<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.11.0-preview.1.26513.7" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" Version="10.11.0-preview.1.26513.7" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docs\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ShopMcpServer is its own project; don't compile or include its files in this one. -->
  <ItemGroup>
    <Compile Remove="ShopMcpServer\**" />
    <Content Remove="ShopMcpServer\**" />
    <None Remove="ShopMcpServer\**" />
  </ItemGroup>

</Project>
